@prefix weapon: <https://priory.gw2/ref/weapon/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zone: <https://priory.gw2/ref/zone/> .

gw2: a owl:Ontology .

<https://gw2ume.org/resource/entity/nevermore_i_experimental_staff> a gw2:Item ;
    rdfs:label "Nevermore I: Experimental Staff"^^xsd:string ;
    priory:confidenceScore 0.95 ;
    priory:ingredientQuantity 3 ;
    priory:soldBy vendor:grandmaster_craftsman_hobbs ;
    gw21:confidenceScore 0.95 .

<https://gw2ume.org/resource/entity/nevermore_ii_the_mnemonic_device> a gw2:Item ;
    rdfs:label "Nevermore II: The Mnemonic Device"^^xsd:string ;
    priory:confidenceScore 0.95 ;
    priory:ingredientQuantity 1 ;
    priory:soldBy vendor:grandmaster_craftsman_hobbs ;
    gw21:confidenceScore 0.95 .

<https://gw2ume.org/resource/entity/nevermore_iii_the_raven_spirit> a gw2:Item ;
    rdfs:label "Nevermore III: The Raven Spirit"^^xsd:string ;
    priory:confidenceScore 0.95 ;
    priory:ingredientQuantity 1 ;
    priory:soldBy vendor:grandmaster_craftsman_hobbs ;
    gw21:confidenceScore 0.95 .

priory:CollectionHuntPrecursor a owl:Class ;
    rdfs:label "Precursor Journey Hunt Step"^^xsd:string ;
    rdfs:subClassOf priory:Item .

priory:CollectionTier a owl:Class ;
    rdfs:label "Precursor Collection Tier (1-4)"^^xsd:string .

priory:ComponentItem a owl:Class ;
    rdfs:label "Component or Sub-Ingredient Item"^^xsd:string ;
    rdfs:subClassOf priory:Item .

priory:CraftingMaterial a owl:Class ;
    rdfs:label "Raw or Refined Crafting Material"^^xsd:string ;
    rdfs:subClassOf priory:Item ;
    owl:disjointWith priory:EquipableItem .

priory:Discipline a owl:Class ;
    rdfs:label "Crafting Discipline"^^xsd:string .

priory:DisciplineRating a owl:Class ;
    rdfs:label "Required Crafting Skill Level"^^xsd:string .

priory:IngredientQuantity a owl:Class ;
    rdfs:label "Quantity count for recipe ingredient"^^xsd:string .

priory:Trinket a owl:Class ;
    rdfs:label "Accessory or Trinket"^^xsd:string ;
    rdfs:subClassOf priory:EquipableItem .

priory:TrophyItem a owl:Class ;
    rdfs:label "Collection Trophy or Quest Item"^^xsd:string ;
    rdfs:subClassOf priory:Item .

priory:acquisitionMethod a owl:DatatypeProperty ;
    rdfs:label "acquisitionMethod"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:string .

priory:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "confidenceScore"^^xsd:string ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:float .

priory:craftedByDiscipline a owl:ObjectProperty ;
    rdfs:label "craftedByDiscipline"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:CraftingDiscipline .

priory:forgeSlot a owl:DatatypeProperty ;
    rdfs:label "forgeSlot"^^xsd:string ;
    rdfs:domain priory:MysticForgeRecipe ;
    rdfs:range xsd:string .

priory:hasPrecursor a owl:ObjectProperty ;
    rdfs:label "hasPrecursor"^^xsd:string ;
    rdfs:domain priory:LegendaryWeapon ;
    rdfs:range priory:PrecursorWeapon .

priory:ingredientQuantity a owl:DatatypeProperty ;
    rdfs:label "ingredientQuantity"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:integer .

priory:locatedInZone a owl:ObjectProperty ;
    rdfs:label "locatedInZone"^^xsd:string ;
    rdfs:domain priory:NPCVendor ;
    rdfs:range priory:Zone .

priory:partOfCollection a owl:ObjectProperty ;
    rdfs:label "partOfCollection"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:CuratedCollection .

priory:precursorTo a owl:ObjectProperty ;
    rdfs:label "precursorTo"^^xsd:string ;
    rdfs:domain priory:PrecursorWeapon ;
    rdfs:range priory:PrecursorWeapon .

priory:producesItem a owl:ObjectProperty ;
    rdfs:label "producesItem"^^xsd:string ;
    rdfs:domain priory:DisciplineRecipe ;
    rdfs:range priory:Item .

priory:requiresCurrency a owl:ObjectProperty ;
    rdfs:label "requiresCurrency"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:Currency .

priory:requiresDisciplineRating a owl:DatatypeProperty ;
    rdfs:label "requiresDisciplineRating"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:integer .

priory:requiresIngredient a owl:ObjectProperty ;
    rdfs:label "requiresIngredient"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:Item .

priory:rewardForStep a owl:ObjectProperty ;
    rdfs:label "rewardForStep"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:CollectionStep .

priory:soldBy a owl:ObjectProperty ;
    rdfs:label "soldBy"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:NPCVendor .

priory:tierNumber a owl:DatatypeProperty ;
    rdfs:label "tierNumber"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range xsd:integer .

priory:upgradesTo a owl:ObjectProperty ;
    rdfs:label "upgradesTo"^^xsd:string ;
    rdfs:domain priory:Item ;
    rdfs:range priory:Item .

