<https://schema.gw2ume.org/core> a owl:Ontology ;
    rdfs:label "Guild Wars 2 Core Ontology"@en ;
    rdfs:comment "Comprehensive OWL 2 ontology representing core Guild Wars 2 domain concepts including items, crafting, recipes, currencies, vendors, and achievements."@en ;
    owl:versionInfo "1.0.0" .

gw2:LegendaryTribute a owl:Class ;
    rdfs:label "Legendary Tribute"@en ;
    rdfs:comment "A composite gift or tribute specifically assembled for legendary weapon generation."@en ;
    rdfs:subClassOf gw2:CraftingMaterial ;
    skos:prefLabel "Legendary Tribute"@en .

gw2:RawMaterial a owl:Class ;
    rdfs:label "Raw Material"@en ;
    rdfs:comment "An unrefined raw resource obtained from harvesting nodes, salvaging, or creature drops (e.g. Elder Wood Log, Mithril Ore, Gossamer Scrap)."@en ;
    rdfs:subClassOf gw2:CraftingMaterial ;
    skos:altLabel "Ore"@en,
        "Raw Mat"@en,
        "Wood Log"@en ;
    skos:prefLabel "Raw Material"@en .

gw2:craftedWithRecipe a owl:ObjectProperty ;
    rdfs:label "crafted with recipe"@en ;
    rdfs:comment "Relates an item to the recipe that produces it."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CraftingRecipe ;
    owl:inverseOf gw2:producesItem ;
    skos:prefLabel "crafted with recipe"@en .

gw2:hasPrecursor a owl:ObjectProperty ;
    rdfs:label "has precursor"@en ;
    rdfs:comment "Relates a legendary weapon to its direct precursor weapon."@en ;
    rdfs:domain gw2:LegendaryWeapon ;
    rdfs:range gw2:PrecursorWeapon ;
    owl:inverseOf gw2:isPrecursorOf ;
    skos:prefLabel "has precursor"@en .

gw2:isMaterialFor a owl:ObjectProperty ;
    rdfs:label "is material for"@en ;
    rdfs:comment "Inverse of requiresMaterial; denotes which recipes use this item as an ingredient."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CraftingRecipe ;
    owl:inverseOf gw2:requiresMaterial ;
    skos:prefLabel "is material for"@en .

gw2:isPrecursorOf a owl:ObjectProperty ;
    rdfs:label "is precursor of"@en ;
    rdfs:comment "Inverse of hasPrecursor; indicates which legendary weapon this precursor culminates in."@en ;
    rdfs:domain gw2:PrecursorWeapon ;
    rdfs:range gw2:LegendaryWeapon ;
    owl:inverseOf gw2:hasPrecursor ;
    skos:prefLabel "is precursor of"@en .

gw2:producesItem a owl:ObjectProperty ;
    rdfs:label "produces item"@en ;
    rdfs:comment "Relates a crafting recipe to the output item it creates."@en ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:craftedWithRecipe ;
    skos:prefLabel "produces item"@en .

gw2:purchasedFrom a owl:ObjectProperty ;
    rdfs:label "purchased from"@en ;
    rdfs:comment "Relates an item to the vendor NPC that sells it."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Vendor ;
    owl:inverseOf gw2:sellsItem ;
    skos:prefLabel "purchased from"@en .

gw2:rewardForAchievement a owl:ObjectProperty ;
    rdfs:label "reward for achievement"@en ;
    rdfs:comment "Specifies the achievement or collection milestone that yields this item."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Achievement ;
    owl:inverseOf gw2:rewardsItem ;
    skos:prefLabel "reward for achievement"@en .

gw2:rewardsItem a owl:ObjectProperty ;
    rdfs:label "rewards item"@en ;
    rdfs:comment "Specifies an item granted upon completing an achievement."@en ;
    rdfs:domain gw2:Achievement ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:rewardForAchievement ;
    skos:prefLabel "rewards item"@en .

gw2:sellsItem a owl:ObjectProperty ;
    rdfs:label "sells item"@en ;
    rdfs:comment "Relates a vendor to an item available in their merchant inventory."@en ;
    rdfs:domain gw2:Vendor ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:purchasedFrom ;
    skos:prefLabel "sells item"@en .

gw2leg:Miyani a owl:NamedIndividual,
        gw2:NPCVendor,
        gw2:Vendor ;
    rdfs:label "Miyani"@en ;
    rdfs:comment "Mystic Forge attendant in Lion's Arch who sells Eldritch Scrolls, Bloodstone Shards, and Philosopher's Stones for Spirit Shards."@en ;
