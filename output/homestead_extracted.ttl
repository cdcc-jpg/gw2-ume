gw2:AirshipPart a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Airship Part"@en ;
    rdfs:comment "Verdant Brink map currency."@en ;
    skos:altLabel "Airship Parts"@en ;
    skos:prefLabel "Airship Part"@en .

gw2:Armorsmith a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Armorsmith"@en ;
    rdfs:comment "Crafts heavy armor and metal storage boxes."@en ;
    skos:prefLabel "Armorsmith"@en .

gw2:AscendedArmor a owl:Class ;
    rdfs:label "Ascended Armor"@en ;
    rdfs:comment "Armor piece of Ascended rarity."@en ;
    rdfs:subClassOf gw2:Armor ;
    skos:prefLabel "Ascended Armor"@en .

gw2:AscendedTrinket a owl:Class ;
    rdfs:label "Ascended Trinket"@en ;
    rdfs:comment "Trinket of Ascended rarity with infusion slots."@en ;
    rdfs:subClassOf gw2:Trinket ;
    skos:prefLabel "Ascended Trinket"@en .

gw2:AscendedWeapon a owl:Class ;
    rdfs:label "Ascended Weapon"@en ;
    rdfs:comment "Weapon of Ascended rarity possessing maximum weapon strength and attribute stats with infusion slots."@en ;
    rdfs:subClassOf gw2:Weapon ;
    skos:prefLabel "Ascended Weapon"@en .

gw2:Chef a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Chef"@en ;
    rdfs:comment "Crafts food consumables and feast platters."@en ;
    skos:prefLabel "Chef"@en .

gw2:Coin a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Coin"@en ;
    rdfs:comment "The primary transactional currency in Guild Wars 2."@en ;
    skos:altLabel "Copper"@en,
        "Gold"@en,
        "Gold Coin"@en,
        "Silver"@en ;
    skos:prefLabel "Coin"@en .

gw2:CrystallineOre a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Crystalline Ore"@en ;
    rdfs:comment "Dragon's Stand map currency harvested from Noxious Pods."@en ;
    skos:altLabel "Ore"@en ;
    skos:prefLabel "Crystalline Ore"@en .

gw2:ExoticWeapon a owl:Class ;
    rdfs:label "Exotic Weapon"@en ;
    rdfs:comment "Weapon of Exotic rarity."@en ;
    rdfs:subClassOf gw2:Weapon ;
    skos:prefLabel "Exotic Weapon"@en .

gw2:Jeweler a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Jeweler"@en ;
    rdfs:comment "Crafts rings, accessories, and amulets."@en ;
    skos:prefLabel "Jeweler"@en .

gw2:Karma a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Karma"@en ;
    rdfs:comment "Earned through events, hearts, and consumables; used with Karma merchants and for Obsidian Shards."@en ;
    skos:prefLabel "Karma"@en .

gw2:Leatherworker a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Leatherworker"@en ;
    rdfs:comment "Crafts medium armor and leather bags."@en ;
    skos:prefLabel "Leatherworker"@en .

gw2:LegendaryArmor a owl:Class ;
    rdfs:label "Legendary Armor"@en ;
    rdfs:comment "Top-tier armor offering selectable stats and skin swapping via the Legendary Armory."@en ;
    rdfs:subClassOf gw2:Armor ;
    skos:prefLabel "Legendary Armor"@en .

gw2:LegendaryTrinket a owl:Class ;
    rdfs:label "Legendary Trinket"@en ;
    rdfs:comment "Legendary accessory, ring, or amulet offering selectable stats and visual auras."@en ;
    rdfs:subClassOf gw2:Trinket ;
    skos:prefLabel "Legendary Trinket"@en .

gw2:LeyLineSpark a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Ley Line Spark"@en ;
    rdfs:comment "Tangled Depths map currency and crafting component."@en ;
    skos:altLabel "Ley Sparks"@en,
        "Sparks"@en ;
    skos:prefLabel "Ley Line Spark"@en .

gw2:LumpOfAurillium a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Lump of Aurillium"@en ;
    rdfs:comment "Auric Basin map currency."@en ;
    skos:altLabel "Aurillium"@en ;
    skos:prefLabel "Lump of Aurillium"@en .

gw2:Scribe a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Scribe"@en ;
    rdfs:comment "Crafts guild hall decorations, schematics, and paper goods."@en ;
    skos:prefLabel "Scribe"@en .

gw2:SpiritShard a owl:NamedIndividual,
        gw2:Currency ;
    rdfs:label "Spirit Shard"@en ;
    rdfs:comment "Currency earned after level 80 used to purchase Mystic Forge materials from Miyani."@en ;
    skos:altLabel "Shards"@en,
        "Spirit Shards"@en ;
    skos:prefLabel "Spirit Shard"@en .

gw2:Tailor a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Tailor"@en ;
    rdfs:comment "Crafts light armor and cloth bags."@en ;
    skos:prefLabel "Tailor"@en .

gw2:costsCurrency a owl:ObjectProperty ;
    rdfs:label "costs currency"@en ;
    rdfs:comment "Specifies a currency required to purchase or acquire an item."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Currency ;
    skos:prefLabel "costs currency"@en .

gw2:disciplineMinRating a owl:DatatypeProperty ;
    rdfs:label "discipline minimum rating"@en ;
    rdfs:comment "Skill level required in the crafting discipline (e.g. 400, 450, 500)."@en ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range xsd:integer ;
    skos:prefLabel "discipline minimum rating"@en .

gw2:generationNumber a owl:DatatypeProperty ;
    rdfs:label "generation number"@en ;
    rdfs:comment "Legendary release generation (1 = Core GW2, 2 = Heart of Thorns / Living World Season 3 & 4, 3 = End of Dragons)."@en ;
    rdfs:domain gw2:LegendaryWeapon ;
    rdfs:range xsd:integer ;
    skos:prefLabel "generation number"@en .

gw2:hasDiscipline a owl:ObjectProperty ;
    rdfs:label "has discipline"@en ;
    rdfs:comment "Relates a crafting recipe to the discipline authorized to craft it."@en ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range gw2:CraftingDiscipline ;
    skos:prefLabel "has discipline"@en .

gw2:hasMysticForgeIngredient a owl:ObjectProperty ;
    rdfs:label "has Mystic Forge ingredient"@en ;
    rdfs:comment "Specifies an input ingredient used specifically in a 4-ingredient Mystic Forge recipe."@en ;
    rdfs:domain gw2:MysticForgeRecipe ;
    rdfs:range gw2:Item ;
    rdfs:subPropertyOf gw2:requiresMaterial ;
    skos:prefLabel "has Mystic Forge ingredient"@en .

gw2:ingredientCount a owl:DatatypeProperty ;
    rdfs:label "ingredient count"@en ;
    rdfs:comment "Quantity of the specified ingredient required."@en ;
    rdfs:range xsd:integer ;
    skos:prefLabel "ingredient count"@en .

gw2:itemRarity a owl:DatatypeProperty ;
    rdfs:label "item rarity"@en ;
    rdfs:comment "Rarity tier of the item: Junk, Basic, Fine, Masterwork, Rare, Exotic, Ascended, Legendary."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:string ;
    skos:prefLabel "item rarity"@en .

gw2:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "Relates a vendor, landmark, or event to its map zone."@en ;
    rdfs:domain gw2:Vendor ;
    rdfs:range gw2:MapZone ;
    skos:prefLabel "located in"@en .

gw2:partOfCollection a owl:ObjectProperty ;
    rdfs:label "part of collection"@en ;
    rdfs:comment "Relates an item or sub-step achievement to a parent collection achievement."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Achievement ;
    skos:prefLabel "part of collection"@en .

gw2:recipeOutputCount a owl:DatatypeProperty ;
    rdfs:label "recipe output count"@en ;
    rdfs:comment "Quantity of items produced upon completing a recipe."@en ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range xsd:integer ;
    skos:prefLabel "recipe output count"@en .

gw2:requiredLevel a owl:DatatypeProperty ;
    rdfs:label "required level"@en ;
    rdfs:comment "Minimum character level required to equip or use this item (e.g. 80)."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:integer ;
    skos:prefLabel "required level"@en .

gw2:upgradesTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "upgrades to"@en ;
    rdfs:comment "Relates a precursor tier to the subsequent tier in the multi-step crafting progression."@en ;
    rdfs:domain gw2:PrecursorWeapon ;
    rdfs:range gw2:PrecursorWeapon ;
    skos:prefLabel "upgrades to"@en .

gw2:vendorCost a owl:DatatypeProperty ;
    rdfs:label "vendor cost"@en ;
    rdfs:comment "Numerical cost to buy an item from a vendor in base units of copper or tokens."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:integer ;
    skos:prefLabel "vendor cost"@en .

<https://schema.gw2ume.org/legendary> a owl:Ontology ;
    rdfs:label "Guild Wars 2 Legendary Crafting Ontology"@en ;
    rdfs:comment "Comprehensive domain ontology representing Generation 1 and Generation 2 Legendary Weapons, Precursor progression chains, Mystic Forge recipes, and crafting requirements in Guild Wars 2."@en ;
    owl:imports <https://schema.gw2ume.org/core> ;
    owl:versionInfo "1.0.0" .

gw2leg:Astralaria a owl:NamedIndividual,
        gw2:LegendaryWeapon ;
