    priory:upgradesTo gw2leg:TheLivingRavens ;
    gw2:disciplineMinRating 450 ;
    gw2:hasDiscipline gw2:Artificer ;
    gw2:itemRarity "Exotic" ;
    gw2:requiredLevel 80 ;
    gw2:requiresMaterial gw2leg:RavenswoodStaff ;
    gw2:rewardForAchievement gw2leg:NevermoreIII_TheRavenSpirit ;
    gw2:tier 3 ;
    gw2:upgradesTo gw2leg:TheLivingRavens .

discipline:huntsman a owl:NamedIndividual,
        priory:CraftingDiscipline ;
    rdfs:label "Huntsman"^^xsd:string .

gw2:TrophyItem a owl:Class ;
    rdfs:label "Trophy Item"@en ;
    rdfs:comment "A quest item, collection reward, or event trophy tied to achievements and progression."@en ;
    rdfs:subClassOf gw2:Item ;
    skos:altLabel "Collection Trophy"@en,
        "Trophy"@en ;
    skos:prefLabel "Trophy Item"@en .

priory:AttributeCombination a owl:Class ;
    rdfs:label "Attribute Combination"@en ;
    rdfs:comment "A standardized set of combat attributes assigned to equipment in Guild Wars 2."@en ;
    rdfs:subClassOf priory:Entity ;
    skos:altLabel "Prefix"@en,
        "Stat Combination"@en,
        "Stat Prefix"@en ;
    skos:prefLabel "Attribute Combination"@en .

discipline:weaponsmith a owl:NamedIndividual,
        priory:CraftingDiscipline ;
    rdfs:label "Weaponsmith"^^xsd:string .

gw2:CraftingMaterial a owl:Class ;
    rdfs:label "Crafting Material"@en ;
    rdfs:comment "An item primarily used as an ingredient in crafting recipes or Mystic Forge conversions."@en ;
    rdfs:subClassOf gw2:Item ;
    owl:disjointWith gw2:Currency ;
    skos:altLabel "Mat"@en,
        "Material"@en,
        "Mats"@en ;
    skos:prefLabel "Crafting Material"@en .

gw2:NPCVendor a owl:Class ;
    rdfs:label "NPC Vendor"@en ;
    rdfs:comment "A non-player character merchant in Tyria."@en ;
    rdfs:subClassOf gw2:Vendor ;
    skos:altLabel "Merchant"@en,
        "Vendor"@en ;
    skos:prefLabel "NPC Vendor"@en .

gw2:PrecursorWeapon a owl:Class ;
    rdfs:label "Precursor Weapon"@en ;
    rdfs:comment "An exotic or ascended weapon that serves as a required base or stepping-stone component for crafting a Legendary Weapon."@en ;
    rdfs:subClassOf gw2:Weapon ;
    skos:altLabel "Precursor"@en ;
    skos:prefLabel "Precursor Weapon"@en .

gw2leg:TheLivingRavens a owl:NamedIndividual,
        gw2:PrecursorWeapon ;
    rdfs:label "The Living Ravens"@en ;
    rdfs:comment "Tier 4 final precursor weapon for Nevermore, infused with raven souls; one of four ingredients in the Nevermore Mystic Forge recipe."@en ;
    skos:altLabel "Living Ravens"@en,
        "Nevermore Precursor"@en,
        "T4 Nevermore"@en,
        "Tier 4 Nevermore Precursor"@en ;
    skos:prefLabel "The Living Ravens"@en ;
    priory:craftedByDiscipline gw2:Artificer ;
    priory:isPrecursorOf gw2leg:Nevermore ;
    priory:requiresDisciplineRating 450 ;
    priory:requiresIngredient gw2leg:TheRavenSpirit ;
    gw2:disciplineMinRating 450 ;
    gw2:hasDiscipline gw2:Artificer ;
    gw2:isPrecursorOf gw2leg:Nevermore ;
    gw2:itemRarity "Ascended" ;
    gw2:requiredLevel 80 ;
    gw2:requiresMaterial gw2leg:TheRavenSpirit ;
    gw2:rewardForAchievement gw2leg:NevermoreIV_TheLivingRavens ;
    gw2:tier 4 .

gw2:CraftingRecipe a owl:Class ;
    rdfs:label "Crafting Recipe"@en ;
    rdfs:comment "A formal formula detailing required materials, quantities, discipline requirements, and resulting items."@en ;
    skos:altLabel "Recipe"@en ;
    skos:prefLabel "Crafting Recipe"@en .

gw2:Currency a owl:Class ;
    rdfs:label "Currency"@en ;
    rdfs:comment "A fungible token or account wallet value used to purchase goods, unlock rewards, or fulfill recipe requirements."@en ;
    skos:prefLabel "Currency"@en .

gw2:GiftComponent a owl:Class ;
    rdfs:label "Gift Component"@en ;
    rdfs:comment "A gift item crafted or purchased to serve as one of the major 4 components in a Legendary Mystic Forge recipe."@en ;
    rdfs:subClassOf gw2:CraftingMaterial ;
    skos:altLabel "Legendary Gift"@en ;
    skos:prefLabel "Gift Component"@en .

gw2:CraftingDiscipline a owl:Class ;
    rdfs:label "Crafting Discipline"@en ;
    rdfs:comment "A crafting profession that a player character can learn and level up to craft items (e.g. Weaponsmith, Artificer, Huntsman)."@en ;
    skos:altLabel "Crafting Profession"@en,
        "Discipline"@en ;
    skos:prefLabel "Crafting Discipline"@en .

gw2:Artificer a owl:NamedIndividual,
        gw2:CraftingDiscipline ;
    rdfs:label "Artificer"@en ;
    rdfs:comment "Crafts staves, scepters, foci, tridents, potions, and tuning crystals."@en ;
    skos:prefLabel "Artificer"@en .

priory:Attribute a owl:Class ;
    rdfs:label "Combat Attribute"@en ;
    rdfs:comment "A primary, secondary, or progression attribute (Power, Precision, Agony Resistance, etc.)."@en ;
    rdfs:subClassOf priory:Entity ;
    skos:altLabel "Combat Stat"@en,
        "Stat"@en ;
    skos:prefLabel "Combat Attribute"@en .

gw2:LegendaryWeapon a owl:Class ;
    rdfs:label "Legendary Weapon"@en ;
    rdfs:comment "Top-tier weapon offering stat-swapping, unique footfalls, draw animations, projectile effects, and Legendary Armory integration."@en ;
    rdfs:subClassOf gw2:Weapon ;
    skos:altLabel "Legendary"@en ;
    skos:prefLabel "Legendary Weapon"@en .

gw2:MapZone a owl:Class ;
    rdfs:label "Map Zone"@en ;
    rdfs:comment "A geographic region or instance within Tyria, the Mists, or Cantha (e.g. Lion's Arch, Auric Basin, Heart of Maguuma)."@en ;
    skos:altLabel "Map"@en,
        "Region"@en,
        "Zone"@en ;
    skos:prefLabel "Map Zone"@en .

gw2:Vendor a owl:Class ;
    rdfs:label "Vendor"@en ;
    rdfs:comment "A non-player character or interactive merchant selling items or recipes in exchange for currencies or tokens."@en ;
    skos:altLabel "Merchant"@en,
        "NPC Vendor"@en ;
    skos:prefLabel "Vendor"@en .

gw2:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "A distinct entity in Guild Wars 2 that can be acquired, stored in inventory, crafted, traded, or consumed."@en ;
    skos:prefLabel "Item"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( gw2:Item gw2:Currency gw2:CraftingDiscipline gw2:CraftingRecipe gw2:Vendor gw2:MapZone gw2:Achievement ) .

[] a owl:AllDisjointClasses ;
    owl:members ( gw2:Weapon gw2:Armor gw2:Trinket gw2:CraftingMaterial ) .

