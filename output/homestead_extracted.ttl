    rdfs:label "Masterwork"^^xsd:string .

rarity:rare a owl:NamedIndividual,
        priory:Rarity ;
    rdfs:label "Rare"^^xsd:string .

stat:berserker a owl:NamedIndividual,
        priory:AttributeCombination ;
    rdfs:label "Berserker's"^^xsd:string ;
    skos:altLabel "Berserker"^^xsd:string,
        "Zojja"^^xsd:string,
        "Zojja's"^^xsd:string ;
    skos:prefLabel "Berserker's"^^xsd:string ;
    priory:hasAscendedPrefix "Zojja's"^^xsd:string ;
    priory:hasExoticPrefix "Berserker's"^^xsd:string ;
    priory:hasPrimaryAttribute attr:power ;
    priory:hasSecondaryAttribute attr:ferocity,
        attr:precision ;
    priory:releasedInExpansion exp:core .

stat:diviner a owl:NamedIndividual,
        priory:AttributeCombination ;
    rdfs:label "Diviner's"^^xsd:string ;
    skos:altLabel "Diviner"^^xsd:string,
        "Forgemaster"^^xsd:string,
        "Forgemaster's"^^xsd:string ;
    skos:prefLabel "Diviner's"^^xsd:string ;
    priory:hasAscendedPrefix "Forgemaster's"^^xsd:string ;
    priory:hasExoticPrefix "Diviner's"^^xsd:string ;
    priory:hasPrimaryAttribute attr:concentration,
        attr:power ;
    priory:hasSecondaryAttribute attr:ferocity,
        attr:precision ;
    priory:releasedInExpansion exp:path_of_fire .

stat:harrier a owl:NamedIndividual,
        priory:AttributeCombination ;
    rdfs:label "Harrier's"^^xsd:string ;
    skos:altLabel "Harrier"^^xsd:string,
        "Zehtuka"^^xsd:string,
        "Zehtuka's"^^xsd:string ;
    skos:prefLabel "Harrier's"^^xsd:string ;
    priory:hasAscendedPrefix "Zehtuka's"^^xsd:string ;
    priory:hasExoticPrefix "Harrier's"^^xsd:string ;
    priory:hasPrimaryAttribute attr:power ;
    priory:hasSecondaryAttribute attr:concentration,
        attr:healing_power ;
    priory:releasedInExpansion exp:path_of_fire .

stat:marauder a owl:NamedIndividual,
        priory:AttributeCombination ;
    rdfs:label "Marauder"^^xsd:string,
        "Marauder's"^^xsd:string ;
    skos:altLabel "Svaard"^^xsd:string,
        "Svaard's"^^xsd:string ;
    skos:prefLabel "Marauder"^^xsd:string ;
    priory:hasAscendedPrefix "Svaard's"^^xsd:string ;
    priory:hasExoticPrefix "Marauder"^^xsd:string ;
    priory:hasPrimaryAttribute attr:power,
        attr:precision ;
    priory:hasSecondaryAttribute attr:ferocity,
        attr:vitality ;
    priory:releasedInExpansion exp:heart_of_thorns .

stat:viper a owl:NamedIndividual,
        priory:AttributeCombination ;
    rdfs:label "Viper's"^^xsd:string ;
    skos:altLabel "Viper"^^xsd:string,
        "Yassith"^^xsd:string,
        "Yassith's"^^xsd:string ;
    skos:prefLabel "Viper's"^^xsd:string ;
    priory:hasAscendedPrefix "Yassith's"^^xsd:string ;
    priory:hasExoticPrefix "Viper's"^^xsd:string ;
    priory:hasPrimaryAttribute attr:condition_damage,
        attr:power ;
    priory:hasSecondaryAttribute attr:expertise,
        attr:precision ;
    priory:releasedInExpansion exp:heart_of_thorns .

