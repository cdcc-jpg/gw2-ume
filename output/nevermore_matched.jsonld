@prefix gw2: <https://gw2ume.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gw2:CraftingMaterial a owl:Class ;
    rdfs:label "Raw or Refined Crafting Material"^^xsd:string ;
    rdfs:subClassOf gw2:Item .

gw2:IngredientQuantity a owl:Class ;
    rdfs:label "Quantity count for recipe ingredient"^^xsd:string .

gw2:TrophyItem a owl:Class ;
    rdfs:label "Collection Trophy or Quest Item"^^xsd:string ;
    rdfs:subClassOf gw2:Item .

gw2:acquisitionMethod a owl:DatatypeProperty ;
    rdfs:label "acquisitionMethod"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:string .

gw2:craftedByDiscipline a owl:ObjectProperty ;
    rdfs:label "craftedByDiscipline"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CraftingDiscipline .

gw2:forgeSlot a owl:DatatypeProperty ;
    rdfs:label "forgeSlot"^^xsd:string ;
    rdfs:domain gw2:MysticForgeRecipe ;
    rdfs:range xsd:string .

gw2:hasPrecursor a owl:ObjectProperty ;
    rdfs:label "hasPrecursor"^^xsd:string ;
    rdfs:domain gw2:LegendaryWeapon ;
    rdfs:range gw2:PrecursorWeapon .

gw2:ingredientQuantity a owl:DatatypeProperty ;
    rdfs:label "ingredientQuantity"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:integer .

gw2:locatedInZone a owl:ObjectProperty ;
    rdfs:label "locatedInZone"^^xsd:string ;
    rdfs:domain gw2:NPCVendor ;
    rdfs:range gw2:Zone .

gw2:obtainedFromVendor a owl:ObjectProperty ;
    rdfs:label "obtainedFromVendor"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:NPCVendor .

gw2:outputItem a owl:ObjectProperty ;
    rdfs:label "outputItem"^^xsd:string ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range gw2:Item .

gw2:partOfCollection a owl:ObjectProperty ;
    rdfs:label "partOfCollection"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CuratedCollection .

gw2:precursorTo a owl:ObjectProperty ;
    rdfs:label "precursorTo"^^xsd:string ;
    rdfs:domain gw2:PrecursorWeapon ;
    rdfs:range gw2:PrecursorWeapon .

gw2:requiresDisciplineRating a owl:DatatypeProperty ;
    rdfs:label "requiresDisciplineRating"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:integer .

gw2:requiresIngredient a owl:ObjectProperty ;
    rdfs:label "requiresIngredient"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Item .

gw2:tierNumber a owl:DatatypeProperty ;
    rdfs:label "tierNumber"^^xsd:string ;
    rdfs:domain gw2:Item ;
    rdfs:range xsd:integer .

