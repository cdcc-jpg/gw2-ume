    skos:definition "Acquiring an item from an NPC merchant using wallet currencies or map tokens."@en .

discipline:artificer a owl:NamedIndividual,
        priory:CraftingDiscipline ;
    rdfs:label "Artificer"^^xsd:string,
        "Artificer (450)"^^xsd:string,
        "Artificer (500)"^^xsd:string,
        "Artificer 500"^^xsd:string .

priory:LegendaryArmor a owl:Class ;
    rdfs:label "Legendary Armor"@en ;
    rdfs:comment "Prestige Legendary Armor sets (Envoy Raid Armor, Obsidian Open World Armor, Mistforged WvW/PvP Armor)."@en ;
    rdfs:subClassOf priory:Armor,
        priory:LegendaryItem .

rarity:Exotic a skos:Concept ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Exotic> ;
    skos:inScheme priory:RarityScheme,
        priory-ref:RarityScheme ;
    skos:notation 5 ;
    skos:prefLabel "Exotic"@en ;
    skos:topConceptOf priory-ref:RarityScheme .

role:EquippedGear a owl:Class,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Equipped Gear Role"@en ;
    rdfs:subClassOf role:GameRole ;
    skos:broader role:GameRole ;
    skos:definition "Active combat equipment slotted into an active character equipment template."@en ;
    skos:inScheme role:GameRoleScheme ;
    skos:prefLabel "Equipped Gear Role"@en ;
    priory:icon "https://render.guildwars2.com/file/F86C0DBF03CCE774807AD37CFF03A993D519CDF0/2699841.png"^^xsd:anyURI .

priory:DisciplineRecipe a owl:Class ;
    rdfs:label "Discipline Crafting Recipe"@en ;
    rdfs:comment "A deterministic recipe executed at a crafting station requiring a specific discipline."@en ;
    rdfs:subClassOf priory:Recipe .

rarity:Rare a skos:Concept ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Rare> ;
    skos:inScheme priory:RarityScheme,
        priory-ref:RarityScheme ;
    skos:notation 4 ;
    skos:prefLabel "Rare"@en ;
    skos:topConceptOf priory-ref:RarityScheme .

rarity:Ascended a skos:Concept ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Ascended> ;
    skos:inScheme priory:RarityScheme,
        priory-ref:RarityScheme ;
    skos:notation 6 ;
    skos:prefLabel "Ascended"@en ;
    skos:topConceptOf priory-ref:RarityScheme .

priory:GiftItem a owl:Class ;
    rdfs:label "Gift Component"@en ;
    rdfs:comment "Intermediate gift components used in high-level Mystic Forge and legendary recipes."@en ;
    rdfs:subClassOf priory:Item,
        priory:LedgerToken .

role:CraftingIngredient a owl:Class,
        owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "Crafting Ingredient"@en ;
    rdfs:subClassOf role:GameRole ;
    skos:broader role:GameRole ;
    skos:definition "Item or material utilized as an input component in crafting discipline or Mystic Forge recipes."@en ;
    skos:inScheme role:GameRoleScheme ;
    skos:prefLabel "Crafting Ingredient"@en ;
    priory:icon "https://render.guildwars2.com/file/0813027CDADB9135602EB1B1AFD90A3FE335410B/849283.png"^^xsd:anyURI .

priory:ContainerizedToken a owl:Class ;
    rdfs:label "Containerized Inventory Token"@en ;
    rdfs:comment "Token occupying discrete container slots in bags, bank, or material storage."@en ;
    rdfs:subClassOf priory:LedgerToken .

priory:CraftingMaterial a owl:Class ;
    rdfs:label "Crafting Material"@en ;
    rdfs:subClassOf priory:Item,
        priory:LedgerToken .

rarity:Legendary a skos:Concept ;
    rdfs:seeAlso <https://wiki.guildwars2.com/wiki/Legendary> ;
    skos:inScheme priory:RarityScheme,
        priory-ref:RarityScheme ;
    skos:notation 7 ;
    skos:prefLabel "Legendary"@en ;
    skos:topConceptOf priory-ref:RarityScheme .

priory:MysticForgeRecipe a owl:Class ;
    rdfs:label "Mystic Forge Recipe"@en ;
    rdfs:comment "A recipe executed in the Mystic Forge using up to 4 ingredients."@en ;
    rdfs:subClassOf priory:Recipe .

priory:Item a owl:Class ;
    rdfs:label "Game Item"@en ;
    rdfs:comment "An item or resource that can exist in an account inventory, bank, or legendary armory."@en ;
    rdfs:subClassOf priory:Entity .

priory:IngredientRequirement a owl:Class ;
    rdfs:label "Ingredient Requirement"@en ;
    rdfs:comment "Reified N-ary relation specifying a required item or currency and its exact quantity."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( gw2:Item gw2:Currency gw2:CraftingDiscipline gw2:CraftingRecipe gw2:Vendor gw2:MapZone gw2:Achievement ) .

[] a owl:AllDisjointClasses ;
    owl:members ( gw2:Weapon gw2:Armor gw2:Trinket gw2:CraftingMaterial ) .

