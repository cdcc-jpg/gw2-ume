<https://schema.gw2ume.org/core> a owl:Ontology ;
    rdfs:label "Guild Wars 2 Core Ontology"@en ;
    rdfs:comment "Comprehensive OWL 2 ontology representing core Guild Wars 2 domain concepts including items, crafting, recipes, currencies, vendors, and achievements."@en ;
    owl:versionInfo "1.0.0" .

gw2:LegendaryTribute a owl:Class ;
    rdfs:label "Legendary Tribute"@en ;
    rdfs:comment "A composite gift or tribute specifically assembled for legendary weapon generation."@en ;
    rdfs:subClassOf gw2:CraftingMaterial ;
    skos:prefLabel "Legendary Tribute"@en .

gw2:RawMaterial a owl:Class ;
    rdfs:label "Raw Material"@en ;
    rdfs:comment "An unrefined raw resource obtained from harvesting nodes, salvaging, or creature drops (e.g. Elder Wood Log, Mithril Ore, Gossamer Scrap)."@en ;
    rdfs:subClassOf gw2:CraftingMaterial ;
    skos:altLabel "Ore"@en,
        "Raw Mat"@en,
        "Wood Log"@en ;
    skos:prefLabel "Raw Material"@en .

gw2:craftedWithRecipe a owl:ObjectProperty ;
    rdfs:label "crafted with recipe"@en ;
    rdfs:comment "Relates an item to the recipe that produces it."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CraftingRecipe ;
    owl:inverseOf gw2:producesItem ;
    skos:prefLabel "crafted with recipe"@en .

gw2:hasPrecursor a owl:ObjectProperty ;
    rdfs:label "has precursor"@en ;
    rdfs:comment "Relates a legendary weapon to its direct precursor weapon."@en ;
    rdfs:domain gw2:LegendaryWeapon ;
    rdfs:range gw2:PrecursorWeapon ;
    owl:inverseOf gw2:isPrecursorOf ;
    skos:prefLabel "has precursor"@en .

gw2:isMaterialFor a owl:ObjectProperty ;
    rdfs:label "is material for"@en ;
    rdfs:comment "Inverse of requiresMaterial; denotes which recipes use this item as an ingredient."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:CraftingRecipe ;
    owl:inverseOf gw2:requiresMaterial ;
    skos:prefLabel "is material for"@en .

gw2:isPrecursorOf a owl:ObjectProperty ;
    rdfs:label "is precursor of"@en ;
    rdfs:comment "Inverse of hasPrecursor; indicates which legendary weapon this precursor culminates in."@en ;
    rdfs:domain gw2:PrecursorWeapon ;
    rdfs:range gw2:LegendaryWeapon ;
    owl:inverseOf gw2:hasPrecursor ;
    skos:prefLabel "is precursor of"@en .

gw2:producesItem a owl:ObjectProperty ;
    rdfs:label "produces item"@en ;
    rdfs:comment "Relates a crafting recipe to the output item it creates."@en ;
    rdfs:domain gw2:CraftingRecipe ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:craftedWithRecipe ;
    skos:prefLabel "produces item"@en .

gw2:purchasedFrom a owl:ObjectProperty ;
    rdfs:label "purchased from"@en ;
    rdfs:comment "Relates an item to the vendor NPC that sells it."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Vendor ;
    owl:inverseOf gw2:sellsItem ;
    skos:prefLabel "purchased from"@en .

gw2:rewardForAchievement a owl:ObjectProperty ;
    rdfs:label "reward for achievement"@en ;
    rdfs:comment "Specifies the achievement or collection milestone that yields this item."@en ;
    rdfs:domain gw2:Item ;
    rdfs:range gw2:Achievement ;
    owl:inverseOf gw2:rewardsItem ;
    skos:prefLabel "reward for achievement"@en .

gw2:rewardsItem a owl:ObjectProperty ;
    rdfs:label "rewards item"@en ;
    rdfs:comment "Specifies an item granted upon completing an achievement."@en ;
    rdfs:domain gw2:Achievement ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:rewardForAchievement ;
    skos:prefLabel "rewards item"@en .

gw2:sellsItem a owl:ObjectProperty ;
    rdfs:label "sells item"@en ;
    rdfs:comment "Relates a vendor to an item available in their merchant inventory."@en ;
    rdfs:domain gw2:Vendor ;
    rdfs:range gw2:Item ;
    owl:inverseOf gw2:purchasedFrom ;
    skos:prefLabel "sells item"@en .

gw2leg:Miyani a owl:NamedIndividual,
        gw2:NPCVendor,
        gw2:Vendor ;
    rdfs:label "Miyani"@en ;
    rdfs:comment "Mystic Forge attendant in Lion's Arch who sells Eldritch Scrolls, Bloodstone Shards, and Philosopher's Stones for Spirit Shards."@en ;
    skos:altLabel "Mystic Forge Attendant"@en ;
    skos:prefLabel "Miyani"@en ;
    priory:locatedInZone gw2leg:LionsArch ;
    gw2:locatedIn gw2leg:LionsArch .

gw2leg:NevermoreIII_TheRavenSpirit a owl:NamedIndividual,
        gw2:CollectionAchievement ;
    rdfs:label "Nevermore III: The Raven Spirit"@en ;
    rdfs:comment "Third tier legendary staff collection exploring the spiritual bond with the Raven Spirit across the Shiverpeaks."@en ;
    skos:altLabel "Nevermore 3"@en,
        "Nevermore III"@en,
        "Raven Spirit Collection"@en ;
    skos:prefLabel "Nevermore III: The Raven Spirit"@en ;
    gw2:rewardsItem gw2leg:TheRavenSpirit .

gw2leg:NevermoreII_RavenswoodStaff a owl:NamedIndividual,
        gw2:CollectionAchievement ;
    rdfs:label "Nevermore II: Ravenswood Staff"@en ;
    rdfs:comment "Second tier legendary staff collection to craft the Ravenswood Staff."@en ;
    skos:altLabel "Nevermore 2"@en,
        "Nevermore II"@en,
        "Ravenswood Staff Collection"@en ;
    skos:prefLabel "Nevermore II: Ravenswood Staff"@en ;
    gw2:rewardsItem gw2leg:RavenswoodStaff .

gw2leg:NevermoreIV_TheLivingRavens a owl:NamedIndividual,
        gw2:CollectionAchievement ;
    rdfs:label "Nevermore IV: The Living Ravens"@en ;
    rdfs:comment "Fourth and final tier legendary staff collection raising and nurturing a raven fledgeling into The Living Ravens."@en ;
    skos:altLabel "Living Ravens Collection"@en,
        "Nevermore 4"@en,
        "Nevermore IV"@en ;
    skos:prefLabel "Nevermore IV: The Living Ravens"@en ;
    gw2:rewardsItem gw2leg:TheLivingRavens .

gw2leg:NevermoreI_RavenswoodBranch a owl:NamedIndividual,
        gw2:CollectionAchievement ;
    rdfs:label "Nevermore I: Ravenswood Branch"@en ;
    rdfs:comment "First tier legendary staff collection to craft the Ravenswood Branch."@en ;
    skos:altLabel "Nevermore 1"@en,
        "Nevermore I"@en,
        "Ravenswood Branch Collection"@en ;
    skos:prefLabel "Nevermore I: Ravenswood Branch"@en ;
    gw2:rewardsItem gw2leg:RavenswoodBranch .

gw2leg:NevermoreMysticForgeRecipe a owl:NamedIndividual,
        gw2:MysticForgeRecipe ;
    rdfs:label "Nevermore Mystic Forge Recipe"@en ;
    rdfs:comment "Mystic Forge recipe combining The Living Ravens, Gift of Nevermore, Mystic Tribute, and Gift of Mastery to forge the Legendary Staff Nevermore."@en ;
    skos:altLabel "Nevermore Forge Recipe"@en ;
    skos:prefLabel "Nevermore Mystic Forge Recipe"@en ;
    priory:producesItem gw2leg:Nevermore ;
    priory:requiresIngredient gw2leg:GiftOfMastery,
        gw2leg:GiftOfNevermore,
        gw2leg:MysticTribute,
        gw2leg:TheLivingRavens ;
    gw2:hasMysticForgeIngredient gw2leg:GiftOfMastery,
        gw2leg:GiftOfNevermore,
        gw2leg:MysticTribute,
        gw2leg:TheLivingRavens ;
    gw2:producesItem gw2leg:Nevermore ;
    gw2:recipeOutputCount 1 ;
    gw2:requiresMaterial gw2leg:GiftOfMastery,
        gw2leg:GiftOfNevermore,
        gw2leg:MysticTribute,
        gw2leg:TheLivingRavens .

gw2leg:RielRunecrafter a owl:NamedIndividual,
        gw2:NPCVendor,
        gw2:Vendor ;
    rdfs:label "Riel Runecrafter"@en ;
    rdfs:comment "Merchant located in Frostgorge Sound selling Icy Runestones for 1 Gold each."@en ;
    skos:altLabel "Icy Runestone Vendor"@en,
        "Riel"@en ;
    skos:prefLabel "Riel Runecrafter"@en ;
    priory:locatedInZone gw2leg:FrostgorgeSound ;
    gw2:locatedIn gw2leg:FrostgorgeSound .

bfo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:comment "An entity that unfolds itself in time or is the instantaneous boundary of such an entity; it has temporal parts."@en ;
    rdfs:subClassOf bfo:BFO_0000001 ;
    skos:prefLabel "Occurrent"@en .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:comment "An occurrent that has temporal proper parts and unfolds in time."@en ;
    rdfs:subClassOf bfo:BFO_0000003 ;
    skos:prefLabel "Process"@en .

bfo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:comment "A realizable entity that is not necessitated by the bearer's physical structure, but is assumed in specific social, operational, or systemic contexts."@en ;
    rdfs:subClassOf bfo:BFO_0000017 ;
    skos:prefLabel "Role"@en .

iao:IAO_0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    rdfs:comment "A generically dependent continuant that is about some entity."@en ;
    rdfs:subClassOf bfo:BFO_0000002 ;
    skos:prefLabel "Information Content Entity"@en .

priory:EquippedItemShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Equipped item must specify a slot IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:inSlot ],
        [ sh:maxCount 1 ;
            sh:message "Equipped item must link to an Item IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:item ] ;
    sh:targetClass priory:EquippedItem .

