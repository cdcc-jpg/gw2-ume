    skos:prefLabel "Untamed"@en ;
    priory:isEliteSpecialization true .

priory:VIPLoungePassShape a sh:NodeShape ;
    sh:property [ sh:message "Every VIP Lounge Pass must declare at least one feature/amenity." ;
            sh:minCount 1 ;
            sh:path priory:hasFeature ] ;
    sh:targetClass priory:VIPLoungePass .

priory:VendorExchangePathShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "VendorExchangePath must specify a required currency." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:requiresCurrency ],
        [ sh:datatype xsd:integer ;
            sh:message "Vendor exchange requiredQuantity must be a positive integer." ;
            sh:minInclusive 1 ;
            sh:path priory:requiredQuantity ] ;
    sh:targetClass priory:VendorExchangePath .

priory:Vindicator a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Vindicator"@en ;
    priory:isEliteSpecialization true .

priory:Viper a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Viper's"@en .

priory:Virtuoso a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Virtuoso"@en ;
    priory:isEliteSpecialization true .

priory:Weaver a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Weaver"@en ;
    priory:isEliteSpecialization true .

priory:Willbender a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Willbender"@en ;
    priory:isEliteSpecialization true .

