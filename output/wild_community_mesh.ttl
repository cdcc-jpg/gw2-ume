priory:Trinket a owl:Class ;
    rdfs:label "Trinket / Jewelry"@en ;
    rdfs:comment "Amulets, Rings, and Accessories equipable in jewelry slots."@en ;
    rdfs:subClassOf priory:EquipableItem .

priory:ZhaitanFacet a owl:NamedIndividual,
        skos:Concept,
        priory:DragonFacet ;
    skos:definition "Death-themed Elder Dragon variant unlocked via the Shadow of the Dragon collection in Arborstone."@en ;
    skos:inScheme priory:ElderDragonFacetScheme ;
    skos:prefLabel "Zhaitan Variant"@en ;
    priory:dragonName "Zhaitan" .

priory:equippedItem a owl:ObjectProperty ;
    rdfs:label "equipped item"@en ;
    rdfs:comment "Links a character or equipment tab to an equipped gear item."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( priory:Character priory:EquipmentTab ) ] ;
    rdfs:range priory:EquippedItem .

priory:hasAttribute a owl:ObjectProperty ;
    rdfs:label "hasAttribute"@en ;
    rdfs:comment "Relates an item, buff, or attribute combination to an associated combat attribute."@en ;
    rdfs:range priory:Attribute .

priory:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature / amenity"@en ;
    rdfs:comment "Specifies an amenity, portal, or convenience feature provided by this item or lounge."@en ;
    rdfs:domain priory:Item .

priory:inSlot a owl:ObjectProperty ;
    rdfs:label "in slot"@en ;
    rdfs:comment "Points to the SKOS equipment slot concept (e.g. slot:WeaponSlotMainHand1, slot:Helm)."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( priory:EquippedItem priory:InventoryBag ) ] ;
    rdfs:range skos:Concept .

priory:isContainerized a owl:DatatypeProperty ;
    rdfs:label "is containerized"@en ;
    rdfs:comment "Indicates whether a token occupies discrete inventory/bank container slots."@en ;
    rdfs:domain priory:LedgerToken ;
    rdfs:range xsd:boolean .

priory:item a owl:ObjectProperty ;
    rdfs:label "item"@en ;
    rdfs:comment "Points to the canonical game item individual."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( priory:EquippedItem priory:InventoryItem ) ] ;
    rdfs:range priory:Item .

priory:producesItem a owl:ObjectProperty ;
    rdfs:label "produces item"@en ;
    rdfs:domain priory:Recipe ;
    rdfs:range priory:Item .

priory:requiredQuantity a owl:DatatypeProperty ;
    rdfs:label "required quantity"@en ;
    rdfs:range xsd:integer .

priory:requiredRating a owl:DatatypeProperty ;
    rdfs:label "required discipline rating (0-500)"@en ;
    rdfs:domain priory:DisciplineRecipe ;
    rdfs:range xsd:integer .

priory:statPrefix a owl:DatatypeProperty ;
    rdfs:label "statPrefix"@en ;
    rdfs:comment "Generic textual prefix name associated with this attribute combination."@en ;
    rdfs:domain priory:AttributeCombination ;
    rdfs:range xsd:string .

priory:tabIndex a owl:DatatypeProperty ;
    rdfs:label "tab index number"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( priory:EquipmentTab priory:BuildTab ) ] ;
    rdfs:range xsd:integer .

