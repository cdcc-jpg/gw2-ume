@prefix armor: <https://priory.gw2/ref/armor/> .
@prefix attribute: <https://priory.gw2/ref/attribute/> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix currency: <https://priory.gw2/ref/currency/> .
@prefix damagetype: <https://priory.gw2/ref/damagetype/> .
@prefix discipline: <https://priory.gw2/ref/discipline/> .
@prefix expansion: <https://priory.gw2/ref/expansion/> .
@prefix gamemode: <https://priory.gw2/ref/gamemode/> .
@prefix guild_enhancement: <https://priory.gw2/id/guild_enhancement/> .
@prefix gw2: <https://schema.gw2ume.org/core#> .
@prefix gw2leg: <https://schema.gw2ume.org/legendary#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix item: <https://priory.gw2/id/item/> .
@prefix itemtype: <https://priory.gw2/ref/itemtype/> .
@prefix mount: <https://priory.gw2/ref/mount/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix path: <https://priory.gw2/id/path/> .
@prefix priory: <https://priory.gw2/def/> .
@prefix priory-ref: <https://priory.gw2/ref/> .
@prefix profession: <https://priory.gw2/ref/profession/> .
@prefix race: <https://priory.gw2/ref/race/> .
@prefix rarity: <https://priory.gw2/ref/rarity/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix recipe: <https://priory.gw2/id/recipe/> .
@prefix region: <https://priory.gw2/ref/region/> .
@prefix role: <https://priory.gw2/ref/role/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix slot: <https://priory.gw2/ref/slot/> .
@prefix stat: <https://priory.gw2/ref/stat/> .
@prefix upgrade: <https://priory.gw2/ref/upgrade/> .
@prefix vendor: <https://priory.gw2/ref/vendor/> .
@prefix weapon: <https://priory.gw2/ref/weapon/> .
@prefix weight: <https://priory.gw2/ref/armor-weight/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zone: <https://priory.gw2/ref/zone/> .

bfo:BFO_0000034 a owl:Class ;
    rdfs:label "function"@en ;
    rdfs:comment "A disposition that exists in virtue of the bearer's physical make-up and design, purpose, or evolutionary selection."@en ;
    rdfs:subClassOf bfo:BFO_0000016 ;
    skos:prefLabel "Function"@en .

iao:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:comment "A relation between an information content entity and the entity that the information content entity is about."@en ;
    rdfs:domain iao:IAO_0000030 ;
    rdfs:range bfo:BFO_0000001 ;
    skos:altLabel "is_about"@en ;
    skos:prefLabel "is about"@en .

priory: a owl:Ontology ;
    rdfs:label "Project Priory Core Ontology"@en ;
    rdfs:comment "Formal OWL 2 DL ontology defining Guild Wars 2 items, recipes, equipment, acquisition pathways, and spatial waypoints."@en ;
    owl:versionInfo "0.2.0" .

priory:AccountWalletScalarShape a sh:NodeShape ;
    rdfs:label "Account Wallet Scalar Shape"@en ;
    rdfs:comment "Enforces structural invariants on unlocated, scalar account-wide currencies."@en ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "AccountWalletScalar must declare exactly one integer apiWalletId."@en ;
            sh:minCount 1 ;
            sh:path priory:apiWalletId ],
        [ sh:datatype xsd:boolean ;
            sh:hasValue false ;
            sh:maxCount 1 ;
            sh:message "AccountWalletScalar isContainerized must be false."@en ;
            sh:minCount 1 ;
            sh:path priory:isContainerized ],
        [ sh:message "AccountWalletScalar cannot play SalvageTarget or MarketCommodity roles."@en ;
            sh:not [ sh:in ( role:SalvageTarget role:MarketCommodity ) ] ;
            sh:path priory:playsRole ] ;
    sh:targetClass priory:AccountWalletScalar .

priory:Assassin a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Assassin's"@en .

priory:Berserker a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Berserker's"@en .

priory:BerserkerSpec a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Berserker"@en ;
    priory:isEliteSpecialization true .

priory:Bladesworn a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Bladesworn"@en ;
    priory:isEliteSpecialization true .

priory:Catalyst a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Catalyst"@en ;
    priory:isEliteSpecialization true .

priory:Cavalier a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Cavalier's"@en .

priory:Celestial a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Celestial"@en .

priory:CharacterShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Character must have exactly one characterName string." ;
            sh:minCount 1 ;
            sh:path priory:characterName ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 80 ;
            sh:message "Character level must be an integer between 1 and 80." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path priory:characterLevel ],
        [ sh:maxCount 1 ;
            sh:message "Character must have exactly one profession concept IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:hasProfession ],
        [ sh:maxCount 1 ;
            sh:message "Character must have exactly one race concept IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:hasRace ],
        [ sh:message "Character disciplines must conform to CharacterDisciplineShape." ;
            sh:node priory:CharacterDisciplineShape ;
            sh:path priory:hasCraftingDiscipline ],
        [ sh:message "Equipment tabs must conform to EquipmentTabShape." ;
            sh:node priory:EquipmentTabShape ;
            sh:path priory:hasEquipmentTab ],
        [ sh:message "Build tabs must conform to BuildTabShape." ;
            sh:node priory:BuildTabShape ;
            sh:path priory:hasBuildTab ],
        [ sh:message "Equipped items must conform to EquippedItemShape." ;
            sh:node priory:EquippedItemShape ;
            sh:path priory:equippedItem ],
        [ sh:message "Inventory bags must conform to InventoryBagShape." ;
            sh:node priory:InventoryBagShape ;
            sh:path priory:hasInventoryBag ] ;
    sh:targetClass priory:Character .

priory:Chronomancer a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Chronomancer"@en ;
    priory:isEliteSpecialization true .

priory:ContainerizedTokenShape a sh:NodeShape ;
    rdfs:label "Containerized Token Shape"@en ;
    rdfs:comment "Enforces structural invariants on containerized inventory tokens."@en ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:hasValue true ;
            sh:maxCount 1 ;
            sh:message "ContainerizedToken isContainerized must be true."@en ;
            sh:minCount 1 ;
            sh:path priory:isContainerized ] ;
    sh:targetClass priory:ContainerizedToken .

priory:ConvenienceGizmoShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "Every Convenience Gizmo must have a chat link code." ;
            sh:minCount 1 ;
            sh:path [ sh:alternativePath ( priory:chatCode priory:chatLink ) ] ] ;
    sh:targetClass priory:AccountStorageUpgrade,
        priory:ConvenienceGizmo,
        priory:CurrencyConverter,
        priory:InfiniteSalvageItem,
        priory:PermanentContract,
        priory:PortalTome,
        priory:SafeStagingBag,
        priory:VIPLoungePass .

priory:CraftingPath a owl:Class ;
    rdfs:label "Crafting Acquisition"@en ;
    rdfs:subClassOf priory:AcquisitionPath ;
    skos:altLabel "build"@en,
        "craft"@en,
        "forge"@en,
        "make"@en ;
    skos:definition "Acquiring an item through crafting disciplines or Mystic Forge recipe transformations."@en .

priory:Daredevil a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Daredevil"@en ;
    priory:isEliteSpecialization true .

priory:Deadeye a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Deadeye"@en ;
    priory:isEliteSpecialization true .

priory:DisciplineRecipeShape a sh:NodeShape ;
    sh:property [ sh:message "DisciplineRecipe must specify a crafting discipline." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:requiresDiscipline ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 500 ;
            sh:message "requiredRating must be an integer between 0 and 500." ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path [ sh:alternativePath ( priory:requiredRating priory:requiresRating ) ] ] ;
    sh:targetClass priory:DisciplineRecipe .

priory:Diviner a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Diviner's"@en .

priory:Dragon a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Dragon's"@en .

priory:Dragonhunter a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Dragonhunter"@en ;
    priory:isEliteSpecialization true .

priory:Druid a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Druid"@en ;
    priory:isEliteSpecialization true .

priory:DungeonPath a owl:Class ;
    rdfs:label "Dungeon Path Acquisition"@en ;
    rdfs:subClassOf priory:AcquisitionPath ;
    skos:altLabel "dungeon"@en,
        "dungeon path"@en,
        "dungeon run"@en ;
    skos:definition "Acquiring items or tokens by completing specific dungeon explorable paths."@en .

priory:Exchange_AstralAcclaim_BagOfCoins a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Astral Acclaim for 1 Gold (Bag of Coins)" ;
    skos:definition "Convert 6 Astral Acclaim into 1 liquid gold coin (up to 90 cheap bags per season)." ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 6 ;
            priory:requiresCurrency currency:AstralAcclaim ] ;
    priory:outputQuantity 1 ;
    priory:producesGold 1.0 ;
    priory:producesItem item:100098 ;
    priory:requiredQuantity 6 ;
    priory:requiresCurrency currency:AstralAcclaim ;
    priory:seasonalCap 90 ;
    priory:vendorName "Wizard's Vault (Direct Claim)" .

priory:Exchange_AstralAcclaim_HeavyCraftingBag a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Astral Acclaim for Heavy Crafting Bag" ;
    skos:definition "Exchange 10 Astral Acclaim for a Heavy Crafting Bag yielding 3 Tier 6 fine crafting materials." ;
    priory:estimatedT6Yield 3 ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 10 ;
            priory:requiresCurrency currency:AstralAcclaim ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:8941 ;
    priory:requiredQuantity 10 ;
    priory:requiresCurrency currency:AstralAcclaim ;
    priory:vendorName "Wizard's Vault (Direct Claim)" .

priory:Exchange_AstralAcclaim_MysticClover a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Astral Acclaim for Mystic Clover" ;
    skos:definition "Cheapest and guaranteed source of Mystic Clovers: 9 Astral Acclaim per clover up to 20 per season." ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 9 ;
            priory:requiresCurrency currency:AstralAcclaim ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:19675 ;
    priory:requiredQuantity 9 ;
    priory:requiresCurrency currency:AstralAcclaim ;
    priory:seasonalCap 20 ;
    priory:vendorName "Wizard's Vault (Direct Claim)" .

priory:Exchange_Fractal_MysticClover a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Fractal Relics for Mystic Clover" ;
    skos:definition "Daily discounted Mystic Clover vendor trade: 2 per day at BUY-2046." ;
    priory:dailyCap 2 ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 2 ;
            priory:requiresItem item:19721 ],
        [ a priory:IngredientRequirement ;
            priory:requiredQuantity 150 ;
            priory:requiresCurrency currency:FractalRelic ],
        [ a priory:IngredientRequirement ;
            priory:requiredQuantity 3 ;
            priory:requiresCurrency currency:SpiritShard ],
        [ a priory:IngredientRequirement ;
            priory:requiredQuantity 1 ;
            priory:requiresItem item:19976 ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:19675 ;
    priory:requiredQuantity 150 ;
    priory:requiresCurrency currency:FractalRelic ;
    priory:vendorName "BUY-2046 (Fractal of the Mists)" .

priory:Exchange_Laurel_HeavyCraftingBag a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Laurels for Heavy Crafting Bag" ;
    skos:definition "Exchange 1 Laurel for a Heavy Crafting Bag containing 3 random T6 fine materials." ;
    priory:estimatedT6Yield 3 ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 1 ;
            priory:requiresCurrency currency:Laurel ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:8941 ;
    priory:requiredQuantity 1 ;
    priory:requiresCurrency currency:Laurel ;
    priory:vendorName "Laurel Merchant (Lion's Arch [&BBAEAAA=])" .

priory:Exchange_Raid_MysticClover a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Magnetite Shards for Mystic Clover" ;
    skos:definition "Weekly discounted Mystic Clover trade: 10 per week for 30 Magnetite Shards + 2g." ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 30 ;
            priory:requiresCurrency currency:MagnetiteShard ],
        [ a priory:IngredientRequirement ;
            priory:requiredQuantity 20000 ;
            priory:requiresCurrency currency:Coin ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:19675 ;
    priory:requiredQuantity 30 ;
    priory:requiresCurrency currency:MagnetiteShard ;
    priory:vendorName "Basic Magnetite Exchange (Aerodrome [&BPUHAAA=])" ;
    priory:weeklyCap 10 .

priory:Exchange_VolatileMagic_TrophyShipment a owl:NamedIndividual,
        priory:VendorExchangePath ;
    rdfs:label "Exchange Volatile Magic for Trophy Shipment" ;
    skos:definition "Exchange 250 Volatile Magic and 1 gold for a Trophy Shipment yielding ~15 T6 fine materials on average." ;
    priory:estimatedT6Yield 15 ;
    priory:hasIngredientRequirement [ a priory:IngredientRequirement ;
            priory:requiredQuantity 250 ;
            priory:requiresCurrency currency:VolatileMagic ],
        [ a priory:IngredientRequirement ;
            priory:requiredQuantity 10000 ;
            priory:requiresCurrency currency:Coin ] ;
    priory:outputQuantity 1 ;
    priory:producesItem item:89141 ;
    priory:requiredQuantity 250 ;
    priory:requiresCurrency currency:VolatileMagic ;
    priory:vendorName "Volatile Magic Collector (Dragonfall [&BNoLAAA=], Mistlock Sanctuary)" .

priory:FarmingLocation a owl:Class ;
    rdfs:label "Farming Location"@en ;
    rdfs:comment "An in-game location optimized for farming specific materials or currencies."@en ;
    rdfs:subClassOf priory:Entity .

priory:Firebrand a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Firebrand"@en ;
    priory:isEliteSpecialization true .

priory:Grieving a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Grieving"@en .

priory:Harbinger a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Harbinger"@en ;
    priory:isEliteSpecialization true .

priory:Harrier a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Harrier's"@en .

priory:Herald a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Herald"@en ;
    priory:isEliteSpecialization true .

priory:Holosmith a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Holosmith"@en ;
    priory:isEliteSpecialization true .

priory:InfiniteSalvageShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:message "Infinite Salvage item must specify salvageCostPerUse." ;
            sh:minInclusive 0 ;
            sh:path priory:salvageCostPerUse ] ;
    sh:targetClass priory:InfiniteSalvageItem .

priory:IngredientRequirementShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Ingredient requirement must have a positive requiredQuantity." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path priory:requiredQuantity ],
        [ sh:maxCount 1 ;
            sh:message "requiresItem must point to an Item IRI." ;
            sh:nodeKind sh:IRI ;
            sh:path priory:requiresItem ] ;
    sh:targetClass priory:IngredientRequirement .

priory:ItemShape a sh:NodeShape ;
    sh:property [ sh:message "Every Item must have at least one rdfs:label." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:integer ;
            sh:message "Item gw2Id must be a positive integer." ;
            sh:minInclusive 1 ;
            sh:path priory:gw2Id ],
        [ sh:message "Item rarity must be an IRI pointing to a SKOS Rarity Concept." ;
            sh:nodeKind sh:IRI ;
            sh:path priory:hasRarity ],
        [ sh:datatype xsd:integer ;
            sh:maxInclusive 80 ;
            sh:message "requiredLevel must be an integer between 0 and 80." ;
            sh:minInclusive 0 ;
            sh:path priory:requiredLevel ],
        [ sh:datatype xsd:integer ;
            sh:message "hasVendorValue must be an integer >= 0." ;
            sh:minInclusive 0 ;
            sh:path priory:hasVendorValue ],
        [ sh:datatype xsd:integer ;
            sh:message "minWeaponPower must be an integer >= 0." ;
            sh:minInclusive 0 ;
            sh:path priory:minWeaponPower ],
        [ sh:datatype xsd:integer ;
            sh:message "maxWeaponPower must be an integer >= 0." ;
            sh:minInclusive 0 ;
            sh:path priory:maxWeaponPower ],
        [ sh:datatype xsd:integer ;
            sh:message "armorDefense must be an integer >= 0." ;
            sh:minInclusive 0 ;
            sh:path priory:armorDefense ] ;
    sh:targetClass priory:AccountStorageUpgrade,
        priory:Armor,
        priory:ConvenienceGizmo,
        priory:CraftingMaterial,
        priory:CurrencyConverter,
        priory:GiftItem,
        priory:HeavyArmor,
        priory:InfiniteSalvageItem,
        priory:Item,
        priory:LegendaryArmor,
        priory:LegendaryRune,
        priory:LegendarySigil,
        priory:LegendaryTrinket,
        priory:LegendaryWeapon,
        priory:LightArmor,
        priory:MediumArmor,
        priory:PermanentContract,
        priory:PortalTome,
        priory:PrecursorWeapon,
        priory:SafeStagingBag,
        priory:Trinket,
        priory:VIPLoungePass,
        priory:Weapon .

priory:KarmaBooster a owl:NamedIndividual,
        priory:ItemBuff ;
    rdfs:label "Karma Booster"@en ;
    rdfs:comment "Increases all karma gain by 50%."@en ;
    priory:accelerationMultiplier "1.5" ;
    priory:duration "60 minutes" .

priory:Knight a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Knight's"@en .

priory:LegendaryCraftingAppOntology a owl:Ontology ;
    rdfs:label "Guild Wars 2 Legendary Crafting Application Ontology"@en ;
    rdfs:comment "Formal OWL 2 DL application schema modeling precursor archetypes, time-gates, account masteries, armory saturation, and stochastic crafting conversions."@en ;
    owl:versionInfo "0.2.0" .

priory:LegendaryRelic a owl:Class ;
    rdfs:label "Legendary Relic"@en ;
    rdfs:subClassOf priory:LegendaryItem,
        priory:Relic .

priory:Marauder a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Marauder"@en .

priory:MasteryLevel a owl:Class ;
    rdfs:label "Mastery Level"@en ;
    rdfs:comment "Alias for Mastery Tier."@en ;
    owl:equivalentClass priory:MasteryTier .

priory:Mechanist a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Mechanist"@en ;
    priory:isEliteSpecialization true .

priory:Minstrel a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Minstrel's"@en .

priory:Mirage a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Mirage"@en ;
    priory:isEliteSpecialization true .

priory:MysticForgePromotionPath a owl:Class ;
    rdfs:label "Mystic Forge Material Promotion"@en ;
    rdfs:subClassOf priory:AcquisitionPath ;
    skos:altLabel "forge promote"@en,
        "promote"@en,
        "transmute"@en ;
    skos:definition "Using the Mystic Forge to upgrade lower-tier materials into higher-tier materials."@en .

priory:ObsidianArmorPrecursor a owl:NamedIndividual,
        skos:Concept,
        priory:PrecursorAcquisitionType ;
    skos:definition "Astral Ward armor pieces upgraded with Purified Kryptis Essences at Lyhr in The Wizard's Tower."@en ;
    skos:inScheme priory:PrecursorAcquisitionScheme ;
    skos:prefLabel "Astral Ward Open-World Armor Precursor"@en ;
    priory:archetypeTag "Astral Ward Upgrade — Open World Rifts & Convergences"@en .

priory:RaidEnvoyPrecursor a owl:NamedIndividual,
        skos:Concept,
        priory:PrecursorAcquisitionType ;
    skos:definition "Ascended Envoy armor precursor earned from Heart of Thorns raid collections I & II."@en ;
    skos:inScheme priory:PrecursorAcquisitionScheme ;
    skos:prefLabel "Raid Envoy Collection Precursor"@en ;
    priory:archetypeTag "Raid Progression — Spirit Vale / Salvation Pass"@en ;
    priory:estimatedGameplayHours 15.0 .

priory:RaidMilestonePath a owl:Class ;
    rdfs:label "Raid / Strike Milestone"@en ;
    rdfs:subClassOf priory:AcquisitionPath ;
    skos:altLabel "boss kill"@en,
        "insights"@en,
        "raid"@en,
        "strike"@en ;
    skos:definition "Earning prestige items by defeating raid wings or strike mission bosses."@en .

priory:Reaper a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Reaper"@en ;
    priory:isEliteSpecialization true .

priory:RecipeShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Every recipe must specify exactly one output item." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:producesItem ],
        [ sh:datatype xsd:integer ;
            sh:message "Output quantity must be an integer >= 1." ;
            sh:minInclusive 1 ;
            sh:path priory:outputQuantity ] ;
    sh:targetClass priory:DisciplineRecipe,
        priory:MysticForgeRecipe,
        priory:Recipe .

priory:Renegade a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Renegade"@en ;
    priory:isEliteSpecialization true .

priory:Ritualist a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
    skos:prefLabel "Ritualist's"@en .

priory:RoleDisjointnessShape a sh:NodeShape ;
    rdfs:label "Role Disjointness Shape"@en ;
    rdfs:comment "Enforces game role exclusivity: an entity cannot simultaneously play both JunkSell and EquippedGear roles."@en ;
    sh:message "An entity cannot simultaneously play both JunkSell and EquippedGear roles."@en ;
    sh:not [ sh:and ( [ sh:hasValue role:JunkSell ;
                        sh:path priory:playsRole ] [ sh:hasValue role:EquippedGear ;
                        sh:path priory:playsRole ] ) ] ;
    sh:targetClass priory:Entity ;
    sh:targetSubjectsOf priory:playsRole .

priory:Scourge a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Scourge"@en ;
    priory:isEliteSpecialization true .

priory:Scrapper a skos:Concept ;
    skos:inScheme priory:SpecializationScheme ;
    skos:prefLabel "Scrapper"@en ;
    priory:isEliteSpecialization true .

priory:Sinister a skos:Concept ;
    skos:inScheme priory:StatCombinationScheme ;
