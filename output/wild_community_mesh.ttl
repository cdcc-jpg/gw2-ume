bfo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    rdfs:comment "A realizable entity that is a tendency or power inhering in an independent continuant in virtue of its physical structure."@en ;
    rdfs:subClassOf bfo:BFO_0000017 ;
    owl:disjointWith bfo:BFO_0000023 ;
    skos:prefLabel "Disposition"@en .

bfo:BFO_0000050 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "A core mereological relation holding between a part and its whole."@en ;
    owl:inverseOf bfo:BFO_0000051 ;
    skos:altLabel "has_part"@en,
        "part_of"@en ;
    skos:prefLabel "part of"@en .

bfo:BFO_0000051 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:comment "Inverse of part of, holding between a whole and its proper or improper parts."@en ;
    owl:inverseOf bfo:BFO_0000050 ;
    skos:altLabel "has_part"@en,
        "part_of"@en ;
    skos:prefLabel "has part"@en .

bfo:BFO_0000052 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en ;
    rdfs:comment "A relation between a specifically dependent continuant and the independent continuant in which it inheres."@en ;
    rdfs:domain bfo:BFO_0000020 ;
    rdfs:range bfo:BFO_0000004 ;
    owl:inverseOf bfo:BFO_0000053 ;
    skos:altLabel "inheres_in"@en ;
    skos:prefLabel "inheres in"@en .

bfo:BFO_0000053 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    rdfs:comment "Inverse of inheres in, holding between an independent continuant and a specifically dependent continuant it bears."@en ;
    rdfs:domain bfo:BFO_0000004 ;
    rdfs:range bfo:BFO_0000020 ;
    owl:inverseOf bfo:BFO_0000052 ;
    skos:altLabel "bearer_of"@en ;
    skos:prefLabel "bearer of"@en .

bfo:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "realized in"@en ;
    rdfs:comment "A relation between a realizable entity and a process that is its realization."@en ;
    rdfs:domain bfo:BFO_0000017 ;
    rdfs:range bfo:BFO_0000015 ;
    owl:inverseOf bfo:BFO_0000055 ;
    skos:altLabel "realized by"@en,
        "realized_in"@en ;
    skos:prefLabel "realized in"@en .

bfo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:comment "Inverse of realized in, relation between a process and a realizable entity that it realizes."@en ;
    rdfs:domain bfo:BFO_0000015 ;
    rdfs:range bfo:BFO_0000017 ;
    owl:inverseOf bfo:BFO_0000054 ;
    skos:prefLabel "realizes"@en .

priory:BackpackItem a owl:Class ;
    rdfs:label "Back Item / Backpack"@en ;
    rdfs:comment "Equipment slotted into the back slot."@en ;
    rdfs:subClassOf priory:EquipableItem .

priory:BuildTabShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Build tab must have an integer tabIndex." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path priory:tabIndex ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "Build tab must specify isActive boolean." ;
            sh:minCount 1 ;
            sh:path priory:isActive ],
        [ sh:message "Specialization slots must conform to SpecializationSlotShape." ;
            sh:node priory:SpecializationSlotShape ;
            sh:path priory:hasSpecializationSlot ] ;
    sh:targetClass priory:BuildTab .

priory:CharacterDisciplineShape a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "CharacterDiscipline must specify a discipline concept IRI." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path priory:discipline ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 500 ;
            sh:message "craftingRating must be an integer between 0 and 500." ;
            sh:minCount 1 ;
            sh:minInclusive 0 ;
            sh:path priory:craftingRating ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "isActive must be a boolean flag." ;
            sh:minCount 1 ;
            sh:path priory:isActive ] ;
    sh:targetClass priory:CharacterDiscipline .

priory:EquipmentTabShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Equipment tab must have an integer tabIndex." ;
            sh:minCount 1 ;
            sh:minInclusive 1 ;
            sh:path priory:tabIndex ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "Equipment tab must specify isActive boolean." ;
            sh:minCount 1 ;
            sh:path priory:isActive ],
        [ sh:message "Equipped items in tab must conform to EquippedItemShape." ;
            sh:node priory:EquippedItemShape ;
            sh:path priory:equippedItem ] ;
    sh:targetClass priory:EquipmentTab .

