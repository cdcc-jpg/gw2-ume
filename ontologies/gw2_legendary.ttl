@prefix : <https://schema.gw2ume.org/legendary#> .
@prefix gw2leg: <https://schema.gw2ume.org/legendary#> .
@prefix gw2: <https://schema.gw2ume.org/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .

<https://schema.gw2ume.org/legendary> rdf:type owl:Ontology ;
    owl:imports <https://schema.gw2ume.org/core> ;
    rdfs:label "Guild Wars 2 Legendary Crafting Ontology"@en ;
    rdfs:comment "Comprehensive domain ontology representing Generation 1 and Generation 2 Legendary Weapons, Precursor progression chains, Mystic Forge recipes, and crafting requirements in Guild Wars 2."@en ;
    owl:versionInfo "1.0.0" .

#################################################################
#    Map Zones
#################################################################

gw2leg:LionsArch rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Lion's Arch"@en ;
    skos:prefLabel "Lion's Arch"@en ;
    skos:altLabel "LA"@en ;
    rdfs:comment "The central trading hub city containing the Mystic Forge, Grandmaster Craftsman Hobbs, and Miyani."@en .

gw2leg:FrostgorgeSound rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Frostgorge Sound"@en ;
    skos:prefLabel "Frostgorge Sound"@en ;
    skos:altLabel "FGS"@en ;
    rdfs:comment "Shiverpeaks zone home to Master Craftsman and vendor of Icy Runestones."@en .

gw2leg:VerdantBrink rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Verdant Brink"@en ;
    skos:prefLabel "Verdant Brink"@en ;
    skos:altLabel "VB"@en ;
    rdfs:comment "Heart of Maguuma zone rewarding Airship Parts and Bladed Armor."@en .

gw2leg:AuricBasin rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Auric Basin"@en ;
    skos:prefLabel "Auric Basin"@en ;
    skos:altLabel "AB"@en ;
    rdfs:comment "Heart of Maguuma zone containing Tarir, The Forgotten City and Aurillium."@en .

gw2leg:TangledDepths rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Tangled Depths"@en ;
    skos:prefLabel "Tangled Depths"@en ;
    skos:altLabel "TD"@en ;
    rdfs:comment "Heart of Maguuma cavern zone yielding Ley Line Sparks and Chak Gerent rewards."@en .

gw2leg:DragonsStand rdf:type owl:NamedIndividual , gw2:MapZone ;
    rdfs:label "Dragon's Stand"@en ;
    skos:prefLabel "Dragon's Stand"@en ;
    skos:altLabel "DS"@en ;
    rdfs:comment "Heart of Maguuma zone hosting the Mouth of Mordremoth meta event and Crystalline Ore pods."@en .


#################################################################
#    Vendors
#################################################################

gw2leg:Miyani rdf:type owl:NamedIndividual , gw2:Vendor ;
    rdfs:label "Miyani"@en ;
    skos:prefLabel "Miyani"@en ;
    skos:altLabel "Mystic Forge Attendant"@en ;
    rdfs:comment "Mystic Forge attendant in Lion's Arch who sells Eldritch Scrolls, Bloodstone Shards, and Philosopher's Stones for Spirit Shards."@en ;
    gw2:locatedIn gw2leg:LionsArch .

gw2leg:GrandmasterHobbs rdf:type owl:NamedIndividual , gw2:Vendor ;
    rdfs:label "Grandmaster Craftsman Hobbs"@en ;
    skos:prefLabel "Grandmaster Craftsman Hobbs"@en ;
    skos:altLabel "Hobbs"@en ;
    rdfs:comment "Legendary crafting merchant in Lion's Arch who unlocks legendary precursor collection achievements and sells intermediate recipes."@en ;
    gw2:locatedIn gw2leg:LionsArch .

gw2leg:RielRunecrafter rdf:type owl:NamedIndividual , gw2:Vendor ;
    rdfs:label "Riel Runecrafter"@en ;
    skos:prefLabel "Riel Runecrafter"@en ;
    skos:altLabel "Riel"@en , "Icy Runestone Vendor"@en ;
    rdfs:comment "Merchant located in Frostgorge Sound selling Icy Runestones for 1 Gold each."@en ;
    gw2:locatedIn gw2leg:FrostgorgeSound .


#################################################################
#    Core Raw & Refined Materials
#################################################################

gw2leg:SpiritwoodPlank rdf:type owl:NamedIndividual , gw2:AscendedMaterial ;
    rdfs:label "Spiritwood Plank"@en ;
    skos:prefLabel "Spiritwood Plank"@en ;
    skos:altLabel "Spiritwood"@en , "Spirit Wood"@en , "Ascended Wood"@en ;
    rdfs:comment "Time-gated Ascended crafting material refined from Glob of Elder Spirit Residue and Elder Wood Planks."@en ;
    gw2:itemRarity "Ascended" ;
    gw2:requiredLevel 80 .

gw2leg:ElderWoodPlank rdf:type owl:NamedIndividual , gw2:RefinedMaterial ;
    rdfs:label "Elder Wood Plank"@en ;
    skos:prefLabel "Elder Wood Plank"@en ;
    skos:altLabel "Elder Plank"@en , "Elder Wood"@en ;
    rdfs:comment "Refined Tier 5 wood material processed from 3 Elder Wood Logs."@en ;
    gw2:itemRarity "Fine" ;
    gw2:requiredLevel 60 .

gw2leg:ElderWoodLog rdf:type owl:NamedIndividual , gw2:RawMaterial ;
    rdfs:label "Elder Wood Log"@en ;
    skos:prefLabel "Elder Wood Log"@en ;
    skos:altLabel "Elder Log"@en , "T5 Wood"@en ;
    rdfs:comment "Tier 5 wood harvested from Cypress and Pine trees across level 60-80 zones."@en ;
    gw2:itemRarity "Basic" .

gw2leg:AncientWoodPlank rdf:type owl:NamedIndividual , gw2:RefinedMaterial ;
    rdfs:label "Ancient Wood Plank"@en ;
    skos:prefLabel "Ancient Wood Plank"@en ;
    skos:altLabel "Ancient Plank"@en , "T6 Wood Plank"@en ;
    rdfs:comment "Refined Tier 6 wood material processed from 3 Ancient Wood Logs."@en ;
    gw2:itemRarity "Fine" ;
    gw2:requiredLevel 80 .

gw2leg:DeldrimorSteelIngot rdf:type owl:NamedIndividual , gw2:AscendedMaterial ;
    rdfs:label "Deldrimor Steel Ingot"@en ;
    skos:prefLabel "Deldrimor Steel Ingot"@en ;
    skos:altLabel "Deldrimor"@en , "Deldrimor Steel"@en , "Ascended Metal"@en ;
    rdfs:comment "Time-gated Ascended crafting metal refined from Lump of Mithrillium, Darksteel Ingots, Platinum Ingots, and Iron Ingots."@en ;
    gw2:itemRarity "Ascended" ;
    gw2:requiredLevel 80 .


#################################################################
#    Mystic Components & Currencies
#################################################################

gw2leg:IcyRunestone rdf:type owl:NamedIndividual , gw2:MysticComponent ;
    rdfs:label "Icy Runestone"@en ;
    skos:prefLabel "Icy Runestone"@en ;
    skos:altLabel "Runestone"@en , "Runestones"@en , "Icy"@en ;
    rdfs:comment "Vendor material purchased from Riel Runecrafter in Frostgorge Sound for 1 Gold each; 100 are needed for Gen 1 & Gen 2 legendary weapons."@en ;
    gw2:itemRarity "Rare" ;
    gw2:vendorCost 10000 ;
    gw2:purchasedFrom gw2leg:RielRunecrafter .

gw2leg:BloodstoneShard rdf:type owl:NamedIndividual , gw2:MysticComponent ;
    rdfs:label "Bloodstone Shard"@en ;
    skos:prefLabel "Bloodstone Shard"@en ;
    skos:altLabel "Bloodstone"@en ;
    rdfs:comment "A mystic ingredient purchased from Miyani for 200 Spirit Shards, essential for the Gift of Mastery."@en ;
    gw2:itemRarity "Exotic" ;
    gw2:purchasedFrom gw2leg:Miyani .

gw2leg:MysticClover rdf:type owl:NamedIndividual , gw2:MysticComponent ;
    rdfs:label "Mystic Clover"@en ;
    skos:prefLabel "Mystic Clover"@en ;
    skos:altLabel "Clover"@en , "Clovers"@en , "Mystic Clovers"@en ;
    rdfs:comment "A lucky 4-leaf clover obtained from Mystic Forge recipes (using Mystic Coins, Glob of Ectoplasm, Obsidian Shards, and Philosopher's Stones) or reward tracks; 77 are needed for Mystic Tribute."@en ;
    gw2:itemRarity "Exotic" .

gw2leg:MysticCoin rdf:type owl:NamedIndividual , gw2:MysticComponent ;
    rdfs:label "Mystic Coin"@en ;
    skos:prefLabel "Mystic Coin"@en ;
    skos:altLabel "Coin"@en , "Coins"@en , "MC"@en , "Mystic Coins"@en ;
    rdfs:comment "Valuable token awarded from daily logins, Ley-Line Anomaly, and Fractals; required for Mystic Clovers and Mystic Forge recipes."@en ;
    gw2:itemRarity "Rare" .

gw2leg:AmalgamatedGemstone rdf:type owl:NamedIndividual , gw2:AscendedMaterial ;
    rdfs:label "Amalgamated Gemstone"@en ;
    skos:prefLabel "Amalgamated Gemstone"@en ;
    skos:altLabel "Amalgam"@en , "Amalgams"@en , "Amalgamated Gemstones"@en , "AG"@en ;
    rdfs:comment "A composite gemstone created by combining rare orbs/crests with Crystalline Dust in the Mystic Forge, or earned from HoT/PoF meta events; 250 are required for the Mystic Tribute."@en ;
    gw2:itemRarity "Exotic" .

gw2leg:ObsidianShard rdf:type owl:NamedIndividual , gw2:MysticComponent ;
    rdfs:label "Obsidian Shard"@en ;
    skos:prefLabel "Obsidian Shard"@en ;
    skos:altLabel "Obsidian"@en , "Obsi Shards"@en ;
    rdfs:comment "Karma-purchased component from Tactician Deathstrider in the Cathedral of Glorious Victory (Orr) or the Silverwastes."@en ;
    gw2:itemRarity "Fine" .


#################################################################
#    Legendary Gifts & Tributes
#################################################################

gw2leg:GiftOfNevermore rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Nevermore"@en ;
    skos:prefLabel "Gift of Nevermore"@en ;
    skos:altLabel "Nevermore Gift"@en ;
    rdfs:comment "The weapon-specific gift required to forge the legendary staff Nevermore in the Mystic Forge."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:MysticTribute rdf:type owl:NamedIndividual , gw2:LegendaryTribute ;
    rdfs:label "Mystic Tribute"@en ;
    skos:prefLabel "Mystic Tribute"@en ;
    skos:altLabel "Tribute"@en , "Gen 2 Tribute"@en ;
    rdfs:comment "The universal tribute component for Generation 2 legendary weapons requiring 77 Mystic Clovers, 250 Amalgamated Gemstones, Gift of Condensed Magic, and Gift of Condensed Might."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfMastery rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Mastery"@en ;
    skos:prefLabel "Gift of Mastery"@en ;
    skos:altLabel "Mastery Gift"@en ;
    rdfs:comment "A core component for Generation 1 and Generation 2 weapons combining Gift of Exploration, Gift of Battle, Bloodstone Shard, and 250 Obsidian Shards."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfMaguumaMastery rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Maguuma Mastery"@en ;
    skos:prefLabel "Gift of Maguuma Mastery"@en ;
    skos:altLabel "Maguuma Mastery"@en ;
