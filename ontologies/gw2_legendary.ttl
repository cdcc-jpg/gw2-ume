    gw2:itemRarity "Legendary" .

gw2leg:GiftOfWood rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Wood"@en ;
    skos:prefLabel "Gift of Wood"@en ;
    skos:altLabel "Wood Gift"@en ;
    rdfs:comment "Gift crafted by Artificer/Huntsman/Weaponsmith requiring 250 Ancient Wood Planks, 250 Elder Wood Planks, 250 Hard Wood Planks, and 250 Seasoned Wood Planks."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfEnergy rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Energy"@en ;
    skos:prefLabel "Gift of Energy"@en ;
    skos:altLabel "Energy Gift"@en ;
    rdfs:comment "Gift crafted by Artificer requiring 250 Piles of Crystalline Dust, 250 Piles of Incandescent Dust, 250 Piles of Luminous Dust, and 250 Piles of Radiant Dust."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfInsight rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Insight"@en ;
    skos:prefLabel "Gift of Insight"@en ;
    skos:altLabel "Insight Gift"@en ;
    rdfs:comment "Gift created specifically for Nevermore combining Raven-themed collection tokens and materials."@en ;
