gw2leg:GiftOfExploration rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Exploration"@en ;
    skos:prefLabel "Gift of Exploration"@en ;
    skos:altLabel "World Completion Gift"@en , "Exploration"@en ;
    rdfs:comment "Awarded in pairs upon achieving 100% Core Tyria World Completion."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfBattle rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Battle"@en ;
    skos:prefLabel "Gift of Battle"@en ;
    skos:altLabel "GoB"@en , "Battle Gift"@en ;
    rdfs:comment "Obtained by completing the Gift of Battle item reward track in World vs. World."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfCondensedMagic rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Condensed Magic"@en ;
    skos:prefLabel "Gift of Condensed Magic"@en ;
    skos:altLabel "Condensed Magic"@en ;
    rdfs:comment "Component of the Mystic Tribute combining Gift of Blood, Gift of Venom, Gift of Totems, and Gift of Dust."@en ;
    gw2:itemRarity "Legendary" .

gw2leg:GiftOfCondensedMight rdf:type owl:NamedIndividual , gw2:GiftComponent ;
    rdfs:label "Gift of Condensed Might"@en ;
    skos:prefLabel "Gift of Condensed Might"@en ;
    skos:altLabel "Condensed Might"@en ;
    rdfs:comment "Component of the Mystic Tribute combining Gift of Claws, Gift of Scales, Gift of Bones, and Gift of Fangs."@en ;
    gw2:itemRarity "Legendary" .


#################################################################
#    Nevermore Precursor Progression Tiers
#################################################################

gw2leg:RavenswoodBranch rdf:type owl:NamedIndividual , gw2:PrecursorWeapon ;
    rdfs:label "Ravenswood Branch"@en ;
    skos:prefLabel "Ravenswood Branch"@en ;
    skos:altLabel "Tier 1 Nevermore Precursor"@en , "Ravenswood Branch (Tier 1)"@en , "T1 Nevermore"@en ;
    rdfs:comment "Tier 1 precursor weapon for Nevermore, awarded after completing the Nevermore I: Ravenswood Branch collection achievement."@en ;
    gw2:itemRarity "Exotic" ;
    gw2:requiredLevel 80 ;
    gw2:upgradesTo gw2leg:RavenswoodStaff ;
    gw2:rewardForAchievement gw2leg:NevermoreI_RavenswoodBranch .

gw2leg:RavenswoodStaff rdf:type owl:NamedIndividual , gw2:PrecursorWeapon ;
    rdfs:label "Ravenswood Staff"@en ;
    skos:prefLabel "Ravenswood Staff"@en ;
    skos:altLabel "Tier 2 Nevermore Precursor"@en , "Ravenswood Staff (Tier 2)"@en , "T2 Nevermore"@en ;
    rdfs:comment "Tier 2 precursor weapon for Nevermore, crafted using the Ravenswood Branch and materials from Nevermore II collection."@en ;
    gw2:itemRarity "Exotic" ;
    gw2:requiredLevel 80 ;
    gw2:upgradesTo gw2leg:TheRavenSpirit ;
    gw2:rewardForAchievement gw2leg:NevermoreII_RavenswoodStaff .

gw2leg:TheRavenSpirit rdf:type owl:NamedIndividual , gw2:PrecursorWeapon ;
    rdfs:label "The Raven Spirit"@en ;
    skos:prefLabel "The Raven Spirit"@en ;
    skos:altLabel "Tier 3 Nevermore Precursor"@en , "The Raven Spirit (Tier 3)"@en , "T3 Nevermore"@en ;
    rdfs:comment "Tier 3 precursor weapon for Nevermore, crafted after completing the Nevermore III: The Raven Spirit collection."@en ;
    gw2:itemRarity "Exotic" ;
    gw2:requiredLevel 80 ;
    gw2:upgradesTo gw2leg:TheLivingRavens ;
    gw2:rewardForAchievement gw2leg:NevermoreIII_TheRavenSpirit .

gw2leg:TheLivingRavens rdf:type owl:NamedIndividual , gw2:PrecursorWeapon ;
    rdfs:label "The Living Ravens"@en ;
    skos:prefLabel "The Living Ravens"@en ;
    skos:altLabel "Living Ravens"@en , "Nevermore Precursor"@en , "Tier 4 Nevermore Precursor"@en , "T4 Nevermore"@en ;
    rdfs:comment "Tier 4 final precursor weapon for Nevermore, infused with raven souls; one of four ingredients in the Nevermore Mystic Forge recipe."@en ;
    gw2:itemRarity "Ascended" ;
    gw2:requiredLevel 80 ;
    gw2:isPrecursorOf gw2leg:Nevermore ;
    gw2:rewardForAchievement gw2leg:NevermoreIV_TheLivingRavens .


#################################################################
